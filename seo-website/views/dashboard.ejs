<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة التحكم - إدارة الصفحات</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-page">
    <header class="admin-header">
        <div class="container">
            <h1>🎯 لوحة تحكم SEO</h1>
            <nav class="admin-nav">
                <a href="/" class="btn btn-secondary">عرض الموقع</a>
                <a href="/admin/logout" class="btn btn-danger">تسجيل الخروج</a>
            </nav>
        </div>
    </header>

    <main class="admin-main">
        <div class="container">
            <div class="admin-header-section">
                <h2>إدارة صفحات SEO</h2>
                <a href="/admin/add-page" class="btn btn-primary">+ إضافة صفحة جديدة</a>
            </div>

            <div class="pages-table-container">
                <table class="pages-table">
                    <thead>
                        <tr>
                            <th>العنوان</th>
                            <th>الرابط (Slug)</th>
                            <th>الكلمات المفتاحية</th>
                            <th>تاريخ الإنشاء</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (pages.length === 0) { %>
                            <tr>
                                <td colspan="5" class="no-pages">لا توجد صفحات بعد. ابدأ بإضافة صفحة جديدة!</td>
                            </tr>
                        <% } else { %>
                            <% pages.forEach(page => { %>
                                <tr>
                                    <td><strong><%= page.title %></strong></td>
                                    <td><code>/page/<%= page.slug %></code></td>
                                    <td>
                                        <div class="keywords-preview">
                                            <% if (page.keywords) { %>
                                                <% page.keywords.split(',').slice(0, 3).forEach(keyword => { %>
                                                    <span class="keyword-tag-small"><%= keyword.trim() %></span>
                                                <% }); %>
                                                <% if (page.keywords.split(',').length > 3) { %>
                                                    <span class="more-keywords">+<%= page.keywords.split(',').length - 3 %></span>
                                                <% } %>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td><%= new Date(page.created_at).toLocaleDateString('ar-SA') %></td>
                                    <td class="actions">
                                        <a href="/page/<%= page.slug %>" class="btn btn-sm btn-secondary" target="_blank">عرض</a>
                                        <a href="/admin/edit-page/<%= page.id %>" class="btn btn-sm btn-primary">تعديل</a>
                                        <a href="/admin/delete-page/<%= page.id %>" class="btn btn-sm btn-danger" onclick="return confirm('هل أنت متأكد من حذف هذه الصفحة؟')">حذف</a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="seo-stats">
                <h3>إحصائيات SEO</h3>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-number"><%= pages.length %></div>
                        <div class="stat-label">عدد الصفحات</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number"><%= pages.filter(p => p.meta_description).length %></div>
                        <div class="stat-label">صفحات بها Meta Description</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number"><%= pages.filter(p => p.keywords).length %></div>
                        <div class="stat-label">صفحات بها كلمات مفتاحية</div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
