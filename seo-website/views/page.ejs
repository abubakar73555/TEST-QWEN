<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page.og_title || page.title %></title>
    <meta name="description" content="<%= page.meta_description %>">
    <meta name="keywords" content="<%= page.keywords %>">
    
    <!-- Open Graph for Social Media -->
    <meta property="og:title" content="<%= page.og_title || page.title %>">
    <meta property="og:description" content="<%= page.og_description || page.meta_description %>">
    <meta property="og:type" content="article">
    
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <h1 class="logo">🚀 SEO Pro</h1>
                <ul class="nav-links">
                    <li><a href="/">الرئيسية</a></li>
                    <li><a href="/#pages">المقالات</a></li>
                    <li><a href="/admin/login">لوحة التحكم</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="page-content">
        <article class="container">
            <header class="page-header">
                <h1><%= page.title %></h1>
                <% if (page.meta_description) { %>
                    <p class="page-meta-desc"><%= page.meta_description %></p>
                <% } %>
                <% if (page.keywords) { %>
                    <div class="page-keywords">
                        <strong>الكلمات المفتاحية:</strong>
                        <% page.keywords.split(',').forEach(keyword => { %>
                            <span class="keyword-tag"><%= keyword.trim() %></span>
                        <% }); %>
                    </div>
                <% } %>
            </header>

            <div class="page-body">
                <%- page.content %>
            </div>

            <footer class="page-footer">
                <p>تاريخ النشر: <%= new Date(page.created_at).toLocaleDateString('ar-SA') %></p>
                <% if (page.updated_at !== page.created_at) { %>
                    <p>آخر تحديث: <%= new Date(page.updated_at).toLocaleDateString('ar-SA') %></p>
                <% } %>
                <a href="/" class="back-link">← العودة إلى الرئيسية</a>
            </footer>
        </article>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2025 SEO Pro - جميع الحقوق محفوظة</p>
        </div>
    </footer>
</body>
</html>
